FLASK_SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga
DATABASE_URL=sqlite:///reminders.db

# Google Calendar OAuth (Cloud API): crea un proyecto en Google Cloud Console,
# habilita "Google Calendar API", crea credenciales OAuth "Desktop app" o "Web app"
# y descarga el JSON de credenciales. Ruta al archivo:
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# WhatsApp Business Cloud API (Meta). Requiere cuenta Meta Business verificada,
# número de teléfono verificado, y una plantilla ("template") aprobada de categoría Utility.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=recordatorio_cita
WHATSAPP_API_VERSION=v20.0

# Cuántas horas antes de la cita se envía el recordatorio
HORAS_ANTES_RECORDATORIO=24

# Stripe TEST MODE únicamente.
STRIPE_SECRET_KEY=REEMPLAZA_CON_TU_CLAVE_STRIPE_TEST_SECRETA
STRIPE_PUBLISHABLE_KEY=REEMPLAZA_CON_TU_CLAVE_STRIPE_TEST_PUBLICA
